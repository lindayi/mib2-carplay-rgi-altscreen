###########################################################################################
# MMI-Cockpit-Carplay - CarPlay private111 Direct Display V2
###########################################################################################
screen "MMI-Cockpit-Carplay" Customization

keyValue
    value   String sys 0x00000000 0
    label   "Preferences: NAV > Navigation settings > Carplay Altscreen"
    poll    0

script
   value   sys 1 0x0100 "/eso/hmi/engdefs/scripts/mqb/install_mmi_cockpit_carplay_rx.sh"
   label   "INSTALL"

script
   value   sys 1 0x0100 "/eso/hmi/engdefs/scripts/mqb/start_mmi_cockpit_carplay_rx_test.sh"
   label   "START"

script
   value   sys 1 0x0100 "/eso/hmi/engdefs/scripts/mqb/status_mmi_cockpit_carplay_test.sh"
   label   "STATUS"

script
   value   sys 1 0x0100 "/eso/hmi/engdefs/scripts/mqb/export_mmi_cockpit_diagnostics.sh"
   label   "EXPORT DIAGNOSTICS ONLY (no restore)"

script
   value   sys 1 0x0100 "/eso/hmi/engdefs/scripts/mqb/finish_mmi_cockpit_carplay_test.sh"
   label   "STORE LOGS + RESTORE"

script
   value   sys 1 0x0100 "/eso/hmi/engdefs/scripts/mqb/stop_mmi_cockpit_carplay_test.sh"
   label   "RESTORE ORIGINAL"

script
   value   sys 1 0x0100 "/mnt/app/root/carplay-performance-rescue/carplay_performance_recover.sh"
   label   "RESCUE: restore performance originals (no SD)"

script
   value   sys 1 0x0100 "/eso/hmi/engdefs/scripts/mqb/dump_cluster_h264.sh"
   label   "Dump cluster video to SD (diagnostic)"
